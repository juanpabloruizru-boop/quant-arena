# Entorno y secretos
.env
*.pem
*.key

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Datos (solo se versionan manifiestos, evidencias y codigo; los datos crudos/curados se regeneran con `qa data sync`)
data/raw/*
data/curated/*
!data/raw/.gitkeep
!data/curated/.gitkeep
!data/manifests/

# Holdout sellado (fuera de data/ por diseño; NUNCA versionar)
holdout_sealed/

# Ledgers binarios (integridad por cadena de hashes + snapshots, ver ADR y M4)
ledger/*.duckdb
ledger/*.duckdb.wal

# estado mutable del motor forward (la evidencia es la cadena forward.jsonl)
ledger/forward_state.json

# backups de reset-examples (artefacto transitorio; los libros reales SI se versionan)
ledger/backup/
